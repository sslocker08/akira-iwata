{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "tools/**",
      "content/**",
      "image/**",
      "*.md"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "img/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      }
    ]
  }
}
